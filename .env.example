# Copy to .env and adjust. Never commit real secrets.

# LLM provider: "echo" (offline, default) or "openai"-compatible HTTP gateway.
AGENT_LLM_PROVIDER=echo
AGENT_LLM_MODEL=gpt-4o-mini
# AGENT_LLM_API_KEY=sk-your-key-here
# AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_REQUEST_TIMEOUT_SECONDS=30

# Orchestration safety cap on tool-use/reasoning steps per agent run.
AGENT_MAX_STEPS=8

# Logging
AGENT_LOG_LEVEL=INFO
AGENT_LOG_JSON=false
